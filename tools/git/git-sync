#!/usr/bin/env bash

set -Eeuo pipefail

source "${BASH_LIB}/args/validate.sh"
source "${BASH_LIB}/api/git.sh"

source "${BASH_TOOLS}/tools/git/_helpers/config.sh"
source "${BASH_TOOLS}/tools/git/_helpers/sync.sh"
source "${BASH_TOOLS}/tools/git/_helpers/view.sh"
source "${BASH_TOOLS}/tools/git/_helpers/worktrees.sh"


usage() {
    echo "usage: git sync [-b <branch>]... [-d] [-s <source>] [-c] [-m ff|merge|rebase] [--force] [--strict]"
}

help() {
cat <<help
GIT-SYNC(1)

NAME

    git sync - Merge a source branch into other branches without switching branches.

SYNOPSIS

    git sync [-b|--branch <branch>]... [-d|--defaults] [-s|--source <source>]
             [-c|--check] [-m|--mode ff|merge|rebase] [--force] [--strict]
    git sync -h|--help

DESCRIPTION

    Syncs <source> (default: "master") into one or more branches in the current
    repo. The currently checked out branch is never switched: branches that are
    checked out in a worktree are synced in place within that worktree, and
    branches that are not checked out anywhere are synced in a throwaway
    worktree that is removed when the command finishes.

    By default every local branch (except <source>) is synced. Use -b|--branch
    to constrain the set of branches, or -d|--defaults to sync only configured
    default branches (see ~/.config/git/config.toml).

    Branches checked out in a worktree listed under [<repo>].sync.exclude in
    ~/.config/git/config.toml are always excluded from syncing.

    -m|--mode controls how branches are synced. A branch that can be
    fast-forwarded always is, regardless of mode; the mode only determines what
    happens to branches that have diverged from <source>:

      ff|fast-forward   only fast-forwards are performed; diverged branches are
                        skipped
      m|merge           diverged branches are synced via merge (default)
      r|rebase          diverged branches are synced via rebase

    When a branch cannot be synced cleanly (e.g. a merge conflict) the
    in-progress operation is aborted and a warning is logged; the remaining
    branches are still synced. With --strict, an error is logged instead and the
    command exits immediately with rc=1 on the first such failure.

    Branches whose working tree has uncommitted changes are skipped (an error is
    logged), since they cannot be safely synced in place. With --force those
    changes are instead stashed before the branch is synced and re-applied to
    the same worktree afterward (a "git add" first captures untracked files).
    Each stash is named "sync-<worktree> @ <timestamp>" and is always dropped
    from the stash list once re-applied. If a stash cannot be re-applied cleanly
    a warning is logged (an error, exiting with rc=1, with --strict).

OPTIONS

    -b, --branch <branch>   constrain the branches to sync; may be given
                            multiple times; defaults to all branches
    -s, --source <source>   the branch to sync from; defaults to "master"
    -m, --mode <mode>       how to sync diverged branches: "ff"|"fast-forward",
                            "m"|"merge" (default), or "r"|"rebase"

FLAGS

    -d, --defaults          sync only configured default branches
    -c, --check             do not sync; write to stdout the branches that
                            would be updated by the sync. Exits 0 if none would
                            be updated, 1 otherwise
        --force             sync branches with uncommitted changes by stashing
                            them (incl. untracked files) before syncing and
                            re-applying the stash afterward
        --strict            exit with rc=1 on the first failure
    -h, --help              display this message
help
}


BRANCHES=()
DEFAULTS_ONLY=""
SOURCE="master"
CHECK=""
MODE="ff"
FORCE=""
STRICT=""

TARGETS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--branch)
      BRANCHES+=("${2}") ; shift 2 ;;
    -d|--defaults)
      DEFAULTS_ONLY="true" ; shift ;;
    -s|--source)
      SOURCE="${2}" ; shift 2 ;;
    -c|--check)
      CHECK="true" ; shift ;;
    -m|--mode)
      MODE="${2}" ; shift 2 ;;
    --force)
      FORCE="true" ; shift ;;
    --strict)
      STRICT="true" ; shift ;;
    -h|--help)
      help && exit 0 ;;
    *)
      usage >&2 && exit 1 ;;
  esac
done


function _validate_in_repo() {
    if ! git::in_repo; then
        ulogger error "not inside a git repository"
        exit 1
    fi
}

function _validate_branch_args() {
    if [[ ${#BRANCHES[@]} -gt 0 && -n "${DEFAULTS_ONLY}" ]]; then
        ulogger error "-b|--branch and -d|--defaults are mutually exclusive"
        exit 1
    fi
}

function _validate_branch_exists() {
    local branch="${1}"
    local type="${2:-}"

    [[ -n "${type}" ]] && type="${type} "

    if ! git::branch_exists "${branch}"; then
        ulogger error "${type}branch '${branch}' does not exist"
        exit 1
    fi
}

function _validate_branches_exist() {
    local branch

    for branch in "${BRANCHES[@]:-}"; do
        [[ -z "${branch}" ]] && continue
        _validate_branch_exists "${branch}"
    done
}

function _normalize_mode() {
    case "${MODE}" in
        ff|fast-forward) MODE="fast-forward" ;;
        m|merge)         MODE="merge" ;;
        r|rebase)        MODE="rebase" ;;
        *)
            validate_one_of "-m|--mode" "${MODE}" \
                ff fast-forward m merge r rebase || exit 1
            ;;
    esac
}

function _validate::args() {
    _validate_in_repo
    _normalize_mode
    _validate_branch_args
    _validate_branch_exists "${SOURCE}" "source"
    _validate_branches_exist
}

function _is_skipped_default() {
    local branch="${1}"
    [[ -n "${DEFAULTS_ONLY}" ]] && ! config::is_default_branch "${branch}"
}

function _get_candidates() {
    local -n _out="${1}"
    _out=("${BRANCHES[@]}")

    [[ ${#_out[@]} -gt 0 ]] && return 0

    while IFS= read -r branch; do
         _is_skipped_default "${branch}" && continue
        _out+=("${branch}")
    done < <(git for-each-ref --format='%(refname:short)' refs/heads/)
}

function _is_excluded() {
    local branch="${1}"
    local worktree

    worktree="$(worktrees::name_for "${branch}")"
    [[ -z "${worktree}" ]] && return 1

    config::is_sync_excluded_worktree "${worktree}" || return 1
    ulogger info "excluding '${branch}': worktree is in sync.exclude"
}

function _should_update() {
    local branch="${1}"

    git::is_ancestor "${SOURCE}" "${branch}" || return 0
    ulogger info "excluding '${branch}': branch already contains '${SOURCE}'"
    return 1
}

function _can_fast_forward() {
    local branch="${1}"

    git::can_fast_forward "${branch}" -s "${SOURCE}"
}

function _is_target() {
    local branch="${1}"

    if _is_excluded "${branch}" || ! _should_update "${branch}"; then
        return 1
    fi

    [[ "${MODE}" != "fast-forward" ]] && return 0

    _can_fast_forward "${branch}" && return 0
    ulogger info "excluding '${branch}': cannot be fast-forward merged w/ '${SOURCE}'"
    return 1
}

function _build_targets() {
    local candidates=("${@}")
    local branch

    for branch in "${candidates[@]}"; do
        [[ "${branch}" = "${SOURCE}" ]] && continue
        _is_target "${branch}" || continue

        TARGETS+=("${branch}")
    done
}

function _setup::select_targets() {
    local candidates=()
    local branch

    _get_candidates candidates
    _build_targets "${candidates[@]}"
}

function _print_group() {
    [[ $# -gt 0 ]] && printf '%s\n' "$@"
    return 0
}

function _main::check() {
    [[ ${#TARGETS[@]} -eq 0 ]] && return 0

    local defaults=()
    local others=()

    local branch
    local worktree
    local out

    for branch in "${TARGETS[@]}"; do
        worktree="$(worktrees::name_for "${branch}")"
        out="$(view::style_branch "${branch}" "${worktree}")"

        if config::is_default_branch "${branch}"; then
            defaults+=("${out}")
        else
            others+=("${out}")
        fi
    done

    # defaults first, then other branches; alphanumeric within each group
    _print_group ${defaults[@]+"${defaults[@]}"}
    _print_group ${others[@]+"${others[@]}"}

    return 1
}

function _main::sync() {
    local branch

    for branch in "${TARGETS[@]}"; do
        sync::branch "${branch}" -o "${SOURCE}" -m "${MODE}" -f "${FORCE}" -s "${STRICT}"
    done

    if sync::has_failures; then
        return 1
    fi
}

## main

trap sync::cleanup EXIT

_validate::args
_setup::select_targets

if [[ ${#TARGETS[@]} -eq 0 ]]; then
    ulogger info "no branches to sync"
    exit 0
fi

if [[ -n "${CHECK}" ]]; then
    _main::check
    exit $?
fi

_main::sync

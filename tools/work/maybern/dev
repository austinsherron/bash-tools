#!/usr/bin/env bash

set -Eeuo pipefail

source "${BASH_LIB}/args/check.sh"
source "${BASH_LIB}/args/parse.sh"
source "${BASH_LIB}/args/validate.sh"
source "${BASH_LIB}/core/str.sh"

DEV_ROOT="${BASH_TOOLS}/tools/work/maybern"

source "${DEV_ROOT}/_helpers/window.sh"
source "${DEV_ROOT}/cmd/local.sh"
source "${DEV_ROOT}/cmd/worktree/main.sh"


# Dispatches "dev <group> <cmd>" to the command implementations in cmd/.
#
# Dispatch is strictly two-level, w/ no implicit fallback to a group: "list"
# exists in both groups, so a bare "dev list" would be ambiguous. Each group
# owns its own command, description, usage and alias tables, and a help message
# per command, all of them named for the group's function prefix:
#
#     <PREFIX>_CMDS          the group's commands (the set dispatch validates against)
#     <PREFIX>_DESCRIPTIONS  one line per command, for the help messages
#     <PREFIX>_GROUP_USAGE   the group's usage string
#     <PREFIX>_USAGE         one usage string per command
#     <PREFIX>_ALIASES       alias -> command
#     <prefix>::help         the group's help message
#     <prefix>::help::<cmd>  a command's help message
#     <prefix>::<cmd>        a command's implementation

declare -A CMD_GROUPS=(
    [local]="local"
    [worktree]="wt"
)

declare -A GROUP_DESCRIPTIONS=(
    [local]="manages the local env session for the current worktree"
    [worktree]="manages worktrees and their local env windows"
)

declare -A GROUP_ALIASES=(
    [l]=local
    [loc]=local
    [wt]=worktree
    [w]=worktree
)

## usage #######################################################################

function groups() {
    str::join "|" "${!CMD_GROUPS[@]}"
}

function group_descriptions() {
    local group
    for group in $(printf '%s\n' "${!GROUP_DESCRIPTIONS[@]}" | sort); do
        printf '    %-12s%s\n' "${group}" "${GROUP_DESCRIPTIONS[${group}]}"
    done
}

#######################################
# Displays a group's commands, one per line, w/ their descriptions.
# Arguments:
#   descriptions: the name of a group's descriptions array
#######################################
function cmd_descriptions() {
    local -n __descriptions="${1}"
    local cmd

    for cmd in $(printf '%s\n' "${!__descriptions[@]}" | sort); do
        printf '    %-12s%s\n' "${cmd}" "${__descriptions[${cmd}]}"
    done
}

#######################################
# Displays a command's aliases, comma separated.
# Arguments:
#   aliases: the name of an alias -> command array
#   cmd: the command whose aliases to display
#######################################
function aliases_for() {
    local -n __aliases="${1}"
    local cmd="${2}"

    local alias
    local found=()

    for alias in "${!__aliases[@]}"; do
        [[ "${__aliases[${alias}]}" == "${cmd}" ]] && found+=("${alias}")
    done

    if [[ "${#found[@]}" -eq 0 ]]; then
        echo "none"
        return 0
    fi

    # shellcheck disable=SC2046
    str::join ", " $(printf '%s\n' "${found[@]}" | sort)
}

USAGE="dev $(groups) <cmd> [args] {flags}"

function usage() {
    echo "${USAGE}"
}

function help() {
cat <<help
DESCRIPTION

A utility for interacting w/ Maybern local development environments orchestrated via tmux.

Worktrees are grouped into categories: each category is a directory beneath the worktree root,
and each worktree w/in it is a work item. Each worktree gets its own window on a separate "dev"
tmux server, where it can be viewed via popup overlay using "local show".

USAGE

    ${USAGE}

GROUPS

$(group_descriptions)

LOCAL COMMANDS

$(cmd_descriptions LOCAL_DESCRIPTIONS)

WORKTREE COMMANDS

$(cmd_descriptions WT_DESCRIPTIONS)

Every group and command has a help message of its own: "dev <group> -h", "dev <group> <cmd> -h".

POSITIONAL ARGUMENTS

    GROUP           the group of the command to run
    CMD             the command to run

FLAGS

    -h, --help      display this message
help
}

# Displays the most specific help message the args resolved to: a command's, its
# group's, or this tool's.
function help_for() {
    [[ -n "${GROUP}" ]] || { help ; return 0 ; }

    local prefix="${CMD_GROUPS[${GROUP}]}"

    [[ -n "${CMD}" ]] || { "${prefix}::help" ; return 0 ; }
    "${prefix}::help::${CMD}"
}

## args ########################################################################

GROUP=""
CMD=""
ARGS=()

function process_group() {
    local group="${1}"

    check::one_of "${group}" "${!GROUP_ALIASES[@]}" && group="${GROUP_ALIASES[${group}]}"
    validate_one_of "GROUP" "${group}" "${!CMD_GROUPS[@]}" || exit 1

    GROUP="${group}"
}

function process_cmd() {
    local cmd="${1}"
    local prefix="${CMD_GROUPS[${GROUP}]}"

    local -n cmds="${prefix^^}_CMDS"
    local -n aliases="${prefix^^}_ALIASES"

    check::one_of "${cmd}" "${!aliases[@]}" && cmd="${aliases[${cmd}]}"
    validate_one_of "CMD" "${cmd}" "${!cmds[@]}" || exit 1

    CMD="${cmd}"
}

[[ $# -gt 0 ]] || { help && exit 0 ; }

while [[ $# -gt 0 ]]; do
  # a help flag always displays help, for whatever the args have resolved so far
  if parse::is_help_flag "${1}"; then
      help_for && exit 0
  fi

  # once the group and command are resolved, everything else belongs to the command
  if [[ -n "${GROUP}" && -n "${CMD}" ]]; then
      ARGS+=("${1}") ; shift ; continue
  fi

  case $1 in
    -v*|-q*)
      shift ;;
    -*)
      echo "usage: $(usage)" >&2 && exit 1 ;;
    *)
      if [[ -z "${GROUP}" ]]; then process_group "${1}" ; else process_cmd "${1}" ; fi
      shift ;;
  esac
done

validate_required_positional "GROUP" "${GROUP}" || exit 1

PREFIX="${CMD_GROUPS[${GROUP}]}"

declare -n GROUP_USAGE="${PREFIX^^}_GROUP_USAGE"
declare -n USAGES="${PREFIX^^}_USAGE"

if [[ -z "${CMD}" ]]; then
    USAGE="${GROUP_USAGE}"

    validate_required_positional "CMD" "${CMD}" || true
    echo "usage: $(usage)" >&2
    echo "run \"dev ${GROUP} -h\" for the group's commands" >&2

    exit 1
fi

## main ########################################################################

# the command's own usage, so that its arg validation failures point at it
USAGE="${USAGES[${CMD}]}"

window::init

"${PREFIX}::${CMD}" ${ARGS[@]+"${ARGS[@]}"}

#!/usr/bin/env bash

set -Eeuo pipefail

source "${BASH_LIB}/log/utils.sh"


USAGE="tmux-resize-layouts {-t window} {options} {flags}"

usage() {
    echo "usage: ${USAGE}"
}

help() {
cat <<help
DESCRIPTION

    Calls resize-layout on multiple tmux windows. This script accepts all resize-layout args and can accept multiple -t|--target args.

    Note: this script is intended to run as a tmux hook on the "client-resized" event.

USAGE

    ${USAGE}

ADDITIONAL OPTIONS

    -t, --target        optional, multi-valued, defaults to all windows (by id); the names or ids (@N) of the windows for which to set a layout

FLAGS

    -h, --help          display this message
help
}


TARGETS=()
CMD=("tmux-resize-layout")

LogFlags::process_log_flags "$@"

while [[ $# -gt 0 ]]; do
  case $1 in
    -t|--target)
      TARGETS+=("${2}") ; shift ; shift ;;
    -v*|-q*)
      shift ;;
    -h|--help)
      help && exit 0 ;;
    *)
      CMD+=("${1}") && shift ;;
  esac
done


# window ids, not names: names aren't unique (several windows are "bash"), and a
# name that is a prefix of another would resolve to the wrong window downstream
if [[ "${#TARGETS[@]}" -eq 0 ]]; then
    mapfile -t TARGETS < <(tmux list-windows -F '#{window_id}')
fi

for target in "${TARGETS[@]}"; do
    TARGET_CMD=("${CMD[@]}" "-t" "${target}")

    ulogger info "resizing tmux layout for target=${target}"
    "${TARGET_CMD[@]}"
done

